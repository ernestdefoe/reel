{
    "name": "ernestdefoe/reel",
    "description": "GIF search in the composer for Flarum 2: trending and search results from GIPHY or KLIPY, one click to drop a GIF into a post. Works with Flarum's editor and Scribe.",
    "keywords": ["flarum", "flarum-extension", "gif", "giphy", "klipy", "composer"],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/ernestdefoe/reel",
    "support": {
        "forum": "https://discuss.flarum.org/d/39997-reel",
        "issues": "https://github.com/ernestdefoe/reel/issues",
        "source": "https://github.com/ernestdefoe/reel"
    },
    "authors": [{ "name": "Ernest Defoe", "email": "ernestdefoe@gmail.com" }],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": { "Ernestdefoe\\Reel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Ernestdefoe\\Reel\\Tests\\": "tests/" }
    },
    "extra": {
        "flarum-extension": {
            "title": "Reel",
            "category": "feature",
            "icon": { "name": "fas fa-film", "backgroundColor": "#db2777", "color": "#fff" }
        }
    },
    "require-dev": {
        "flarum/bbcode": "^2.0",
        "flarum/markdown": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "beta",
    "prefer-stable": true
}
